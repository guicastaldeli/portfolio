FROM node:22-alpine AS builder
WORKDIR /app

COPY package*.json tsconfig.json ./
COPY app ./app

RUN npm install && npx tsc

FROM nginx:alpine
RUN rm -rf /usr/share/nginx/html/*

COPY --from=builder /app/app/index.html /usr/share/nginx/html/index.html
COPY --from=builder /app/app/styles/client.css /usr/share/nginx/html/styles/client.css
COPY --from=builder /app/.out /usr/share/nginx/html/.out

COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80